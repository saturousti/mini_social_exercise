{% extends "user_profile.html.j2" %}

{% block content %}
<div class="container mt-5" style="max-width: 600px;">
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="card-title mb-4">Edit Profile</h2>

      <form method="POST" action="{{ url_for('edit_profile') }}" enctype="multipart/form-data">
        
        <!-- profile pic section -->
        <div class="mb-4 text-center">
          <label class="form-label d-block fw-bold">Current Profile Picture</label>
          
          {% if user.profile_image %}
            <div class="mb-3">
              <img src="{{ url_for('static', filename='uploads/avatars/' + user.profile_image) }}" 
                   alt="{{ user.username }}" class="rounded-circle mb-2" width="90" height="90" style="object-fit: cover;">
              
              <div class="form-check d-flex justify-content-center align-items-center gap-2 mt-1">
                <input class="form-check-input" type="checkbox" name="remove_image" id="remove_image" value="1">
                <label class="form-check-label text-danger fw-bold" for="remove_image">
                  🗑️ Delete current photo
                </label>
              </div>
            </div>
          {% else %}
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white mb-3" 
                 style="width: 90px; height: 90px; background-color: {{ loop_color(user.id) }}; font-size: 36px; font-weight: bold;">
                {{ user.username[0].upper() }}
            </div>
          {% endif %}

          <!-- upload photo -->
          <div class="text-start">
            <label for="profile_image" class="form-label fw-bold">Upload New Photo</label>
            <input type="file" class="form-control" id="profile_image" name="profile_image" accept="image/*">
            <small class="form-text text-muted">Select a file to update your photo.</small>
          </div>
        </div>

        <!-- Bio -->
        <div class="mb-3">
          <label for="profile" class="form-label fw-bold">Bio</label>
          <textarea class="form-control" id="profile" name="profile" rows="3">{{ user.profile or '' }}</textarea>
        </div>

        <!-- loaction -->
        <div class="mb-3">
          <label for="location" class="form-label fw-bold">Location</label>
          <input type="text" class="form-control" id="location" name="location" value="{{ user.location or '' }}">
        </div>

        <!-- buttons for cancel and save changes -->
        <div class="d-flex justify-content-between mt-4">
          <a href="{{ url_for('user_profile', username=user.username) }}" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>

      </form>
    </div>
  </div>
</div>
{% endblock %}