{% extends "base.html.j2" %}

{% block content %}
<div class="container mt-4">
    <div class="d-flex align-items-center mb-3">
        <h1 class="me-3">{{ group.icon }}</h1>
        <div>
            <h2>{{ group.name }}</h2>
            <p class="text-muted mb-0">{{ group.description }}</p>
        </div>
        <div class="ms-auto">
            {% if session.get('user_id') %}
                {% if is_member %}
                    <form action="{{ url_for('leave_group', group_id=group.id) }}" method="POST">
                        <button type="submit" class="btn btn-outline-danger">Exit group</button>
                    </form>
                {% else %}
                    <form action="{{ url_for('join_group', group_id=group.id) }}" method="POST">
                        <button type="submit" class="btn btn-success">Join group</button>
                    </form>
                {% endif %}
            {% endif %}
        </div>
    </div>

    <hr>

    {% if session.get('user_id') %}
        {% if is_member %}
            <!-- Create a new post form (Visible ONLY to members) -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h5>Write a new post to the group</h5>
                    <form action="{{ url_for('add_group_post', group_id=group.id) }}" method="POST">
                        <div class="mb-3">
                            <textarea name="content" class="form-control" rows="3" placeholder="What's on your mind?" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Post to group</button>
                    </form>
                </div>
            </div>

            <!-- Group's posts (Visible ONLY to members) -->
            <h3>Group's conversations</h3>
            {% if posts %}
                {% for post in posts %}
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">
                                <a href="{{ url_for('user_profile', username=post.username) }}">@{{ post.username }}</a>
                                · {{ post.created_at | datetimeformat }}
                            </h6>
                            <p class="card-text">{{ post.content }}</p>
                            <a href="{{ url_for('post_detail', post_id=post.id) }}" class="btn btn-sm btn-outline-dark mt-2">
                                💬 Comments
                            </a>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <p class="text-muted">There are no publications in this group yet. Be the first one to post!</p>
            {% endif %}

        {% else %}
            <!-- Message displayed when logged in but NOT a member -->
            <div class="alert alert-warning text-center py-4 my-4 shadow-sm">
                <h4>🔒 Private Group Content</h4>
                <p class="mb-3">You must be a member of <strong>{{ group.name }}</strong> to view and participate in conversations.</p>
                <form action="{{ url_for('join_group', group_id=group.id) }}" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-success btn-lg">Join group to unlock content</button>
                </form>
            </div>
        {% endif %}
    {% else %}
        <!-- Message displayed when NOT logged in -->
        <div class="alert alert-info text-center py-4 my-4 shadow-sm">
            <h4>🔒 Private Group</h4>
            <p class="mb-3">Please log in and join the group to view conversations.</p>
            <a href="{{ url_for('login') }}" class="btn btn-primary">Log in</a>
        </div>
    {% endif %}
</div>
{% endblock %}